# Copia este archivo como .env (en C:\tesis) y ajusta los valores. El .env NO se sube a git.
# Las claves viven solo aquí, nunca en el código ni en la app móvil.

# --- Base de datos (desarrollo local) ---
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=turismo_db
DB_USER=postgres
DB_PASSWORD=tesis2026

# --- Búsqueda (calibrados con pocos sitios; recalibrar con calibrar_umbral.py) ---
UMBRAL=0.50
MARGEN=0.10
TOP_K=3
RADIO_CERCA_KM=1.5
RADIO_EVENTO_KM=3
LIMITE_CONSULTAS=20/minute

# --- LLM (opcional). Sin clave, el asistente responde igual con plantillas. ---
# LLM_PROVEEDOR: ninguno | anthropic | openai (cualquier servicio compatible con la API de OpenAI)
LLM_PROVEEDOR=ninguno
LLM_MODELO=
LLM_API_KEY=
# Solo para el proveedor "openai": dirección base del servicio
LLM_URL_BASE=https://api.openai.com/v1

# --- Wikipedia (solo cultura, siempre después del RAG) ---
TEMAS_WIKIPEDIA=leyenda,tradicion,fiesta,comida,danza,musica,historia,personaje
# Wikimedia pide un contacto en el User-Agent (tu correo o la página del proyecto). Sin esto, Wikipedia
# responde 403 y el asistente dice "No tengo información sobre eso" en los temas culturales.
WIKIPEDIA_CONTACTO=

# --- Bot de Telegram (opcional). Sin token, el bot no arranca y no pasa nada. ---
TELEGRAM_TOKEN=

# --- Gemini con Pydantic AI (LLM_PROVEEDOR=google). La clave también se acepta como LLM_API_KEY ---
GOOGLE_API_KEY=
# --- Búsqueda web con Tavily (créditos gratuitos limitados) ---
TAVILY_API_KEY=
TAVILY_SCORE_MIN=0.5
# Sitios donde Tavily puede buscar, separados por comas. Agrega aquí los sitios oficiales.
DOMINIOS_CONFIABLES=es.wikipedia.org
